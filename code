pipeline:
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/Aswini-30/TripFreeStyle.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('TripFreeStyle') {
                    // Use Jenkins’ Node if PATH is set correctly
                    bat 'npm install'
                }
            }
        }

        stage('Build') {
            steps {
                dir('TripFreeStyle') {
                    bat 'npm run build'
                }
            }
        }
    }

    post {
        success {
            echo "✅ React project built successfully!"
        }
        failure {
            echo "❌ Build failed!"
        }
    }
}

